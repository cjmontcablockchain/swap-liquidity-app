# RPC endpoint used for fork tests and deployment. Defaults to the public
# Arbitrum RPC in test/SwapApp.t.sol if not set.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Address of the Uniswap V2-compatible router to deploy SwapApp against.
V2_ROUTER_ADDRESS=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24

# Deployer private key. Never commit a real key — keep this file untracked.
PRIVATE_KEY=
