# Free project id from https://cloud.reown.com (required by RainbowKit for WalletConnect)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: custom Arbitrum Sepolia RPC URL. Falls back to wagmi's default public RPC.
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# Addresses printed by `forge script script/DeployTestnet.s.sol --broadcast ...`
VITE_SWAP_APP_ADDRESS=
VITE_ROUTER_ADDRESS=
VITE_DUSD_ADDRESS=
VITE_DDAI_ADDRESS=
